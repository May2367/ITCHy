# Slice and node names
SLICE_NAME=itchy-link-test-l2
SENDER_NODE=sender
RECEIVER_NODE=receiver

# FABRIC placement and VM sizing
SITE=MICH
CORES=2
RAM=8
DISK=50
IMAGE=default_ubuntu_22
SUBMIT_TIMEOUT=1800

# Data and remote runtime paths
LOCAL_DATA_FILE=data/tvagg.gz
REMOTE_SRC_DIR=/opt/itchy-src
REMOTE_RUN_DIR=/tmp/itchy-run
REMOTE_DATA_PATH=/tmp/itchy-run/tvagg.gz
REMOTE_PORT=9000
SENDER_DATA_IP=192.168.100.1
RECEIVER_DATA_IP=192.168.100.2
DATA_PREFIX=24

# Local result directory, relative to vm_link_test/
RESULTS_DIR=results
